.mypy_cache/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Pipeline artifacts (large, generated)
artifacts/
repos/
workspaces/
docker/data/

# Local live-test workspace (never commit; contains real API keys, real
# Allium queries, real workspaces). Renamed from "Tests" to "live_tests"
# to avoid the case-insensitive collision with "tests/" on macOS HFS+/APFS.
# Do NOT add `/Tests/` here: macOS treats it as identical to `tests/` and
# would ignore the entire test suite.
/live_tests/

# Logs
*.log
logs/

# Docker
docker-compose.override.yml

# live_check.py output
live_check_report.json

# Claude Code agent worktrees (transient)
.claude/worktrees/

# Generated figure PDF byproduct (regenerate via scripts/gen_pipeline_figure.py)
docs/figures/*.pdf

# WS-F / WS-P3.2 run outputs (keep the experiments/*.yaml configs, ignore the
# generated run dirs: results.csv, summary.md, exported bundles).
experiments/*/
matrix-*/

# The showcase bundle is a verified artifact, not build output. provenance.json
# inventories every file in it and `e2er verify` fails when one is missing, so a
# rule that drops part of it (*.log caught code/scratch/paper_draft.log) ships a
# bundle that verifies only on the machine that produced it.
!examples/showcase/**

# ...but never secrets, keys or databases, even inside the bundle. The negation
# above is last-match-wins and would otherwise switch off every rule in this
# file for that path: a test repo with the earlier version staged
# examples/showcase/.env, id_rsa and data.db on `git add -A`. A bundle is an
# artifact, not an excuse to commit a credential.
examples/showcase/**/.env
examples/showcase/**/.env.*
examples/showcase/**/*.pem
examples/showcase/**/*.key
examples/showcase/**/*_rsa
examples/showcase/**/*_rsa.pub
examples/showcase/**/id_*
examples/showcase/**/*.db
examples/showcase/**/*.sqlite
examples/showcase/**/*.sqlite-*
examples/showcase/**/credentials*
examples/showcase/**/*secret*
examples/showcase/**/*token*
