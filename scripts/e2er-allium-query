#!/usr/bin/env bash
# Back-compat shim. The Allium gatekeeper moved into the unified
# `e2er-data` wrapper as the `allium` source on 2026-05-17 (v0.4 prep).
# This shim re-prefixes the old `e2er-allium-query <cmd>` invocation as
# `e2er-data allium <cmd>` so external scripts and any unmigrated skill
# files keep working through a deprecation window.
#
# Will be removed in v0.5.0. Migrate to `e2er-data allium <cmd>` for new
# code.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/e2er-data" allium "$@"
