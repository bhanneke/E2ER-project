  "paths": {
    "/api/v1/developer/tokens/chain-address": {
      "post": {
        "tags": [
          "TOKENS",
          "DEVELOPER"
        ],
        "summary": "Get Tokens",
        "operationId": "get_tokens_api_v1_developer_tokens_chain_address_post",
        "security": [
          {
            "APIKeyBearer": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PayloadTokenAddress"
                },
                "minItems": 1,
                "maxItems": 200,
                "title": "Payloads"
              },
              "example": [
                {
                  "token_address": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
                  "chain": "ethereum"
                },
                {
                  "token_address": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
                  "chain": "solana"
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Token"
                      },
                      {
                        "$ref": "#/components/schemas/TokenNotFoundError"
                      }
                    ]
                  },
                  "title": "Response Get Tokens Api V1 Developer Tokens Chain Address Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/developer/tokens": {
      "get": {
        "tags": [
          "TOKENS",
          "DEVELOPER"
        ],
        "summary": "Get Tokens List",
        "operationId": "get_tokens_list_api_v1_developer_tokens_get",
        "security": [
          {
            "APIKeyBearer": []
          }
        ],
        "parameters": [
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "schema": {
              "description": "The chain of the tokens. Do not pass anything to search across all tokens.",
              "title": "Chain",
              "type": "string"
            },
            "description": "The chain of the tokens. Do not pass anything to search across all tokens."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "volume",
                "trade_count",
                "fully_diluted_valuation"
              ],
              "type": "string",
              "description": "Sort by a certain field",
              "default": "volume",
              "title": "Sort"
            },
            "description": "Sort by a certain field"
          },
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/api_server__app__routes__api__developer__tokens__tokens__Granularity"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Granularity of the sorting field. Only used if sort is volume or trade_count.",
              "title": "Granularity"
            },
            "description": "Granularity of the sorting field. Only used if sort is volume or trade_count."
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "description": "Sorting order",
              "default": "desc",
              "title": "Order"
            },
            "description": "Sorting order"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 0,
              "description": "Maximum number of tokens to return.",
              "default": 200,
              "title": "Limit"
            },
            "description": "Maximum number of tokens to return."
          },
          {
            "name": "volume_usd_1d_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Minimum 1d volume in USD. Only returns tokens with volume >= this value.",
              "title": "Volume Usd 1D Threshold",
              "type": "number"
            },
            "description": "Minimum 1d volume in USD. Only returns tokens with volume >= this value."
          },
          {
            "name": "volume_usd_1h_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Minimum 1h volume in USD. Only returns tokens with volume >= this value.",
              "title": "Volume Usd 1H Threshold",
              "type": "number"
            },
            "description": "Minimum 1h volume in USD. Only returns tokens with volume >= this value."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Token"
                  },
                  "title": "Response Get Tokens List Api V1 Developer Tokens Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
