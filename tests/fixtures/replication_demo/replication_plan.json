  },
  "entry_points": [
    {
      "id": "did_main",
      "command": [
        "Rscript",
        "assistencia_social/R/07_did.R"
      ],
      "cwd": "supplementary_elections_social_assistance",
      "timeout_minutes": 30,
      "needs_network": false,
      "produces": [
        "assistencia_social/output/data/resultados_did.csv"
      ],
      "notes": "Main DiD: 4 estimators × 6 outcomes × 2 specs"
    },
    {
      "id": "robustez_especificacoes",
      "command": [
        "Rscript",
        "assistencia_social/R/08_robustez.R"
      ],
      "cwd": "supplementary_elections_social_assistance",
      "timeout_minutes": 30,
      "needs_network": false,
      "produces": [
        "assistencia_social/output/data/robustez_especificacoes.csv",
        "assistencia_social/output/data/robustez_placebo.csv",
        "assistencia_social/output/data/robustez_coorte.csv",
        "assistencia_social/output/data/robustez_subamostras.csv",
        "assistencia_social/output/data/robustez_transformacoes.csv"
      ],
      "notes": "Robustness checks: specifications, placebo, cohorts, subsamples, transformations"
    },
    {
      "id": "robustez_multidesfecho",
      "command": [
        "Rscript",
        "assistencia_social/R/10_robustez_completa.R"
      ],
      "cwd": "supplementary_elections_social_assistance",
      "timeout_minutes": 60,
      "needs_network": false,
      "produces": [
        "assistencia_social/output/data/robustez_multidesfecho_fdr.csv"
      ],
      "notes": "Multi-outcome FDR correction"
    },
    {
      "id": "pretrends_honestdid",
      "command": [
        "Rscript",
        "assistencia_social/R/11_honestdid.R"
      ],
      "cwd": "supplementary_elections_social_assistance",
      "timeout_minutes": 30,
      "needs_network": false,
      "produces": [
        "assistencia_social/output/data/robustez_pretendencias.csv",
        "assistencia_social/output/data/honestdid_cs.csv"
      ],
      "notes": "Pre-trends Wald tests and HonestDiD sensitivity"
    },
    {
      "id": "poder_balanco",
      "command": [
        "Rscript",
        "assistencia_social/R/13_poder_balanco.R"
      ],
      "cwd": "supplementary_elections_social_assistance",
      "timeout_minutes": 15,
      "needs_network": false,
      "produces": [
        "assistencia_social/output/data/poder_mde.csv",
        "assistencia_social/output/data/balanco_tratado_naotratado.csv"
      ],
      "notes": "MDE at 80% power; baseline balance"
    },
    {
      "id": "incentivo_gradient",
      "command": [
        "Rscript",
        "assistencia_social/R/30_proxy_incentivo_norma.R"
      ],
      "cwd": "supplementary_elections_social_assistance",
      "timeout_minutes": 20,
      "needs_network": false,
      "produces": [
        "assistencia_social/output/data/proxy_incentivo_norma.csv",
        "assistencia_social/output/data/proxy_incentivo_norma_gradiente.csv",
        "assistencia_social/output/data/proxy_incentivo_norma_permutacao.csv",
        "assistencia_social/output/data/proxy_incentivo_norma_residual.csv"
      ],
      "notes": "Heterogeneity by incentive intensity terciles"
    }
  ],
  "exhibits": [
    {
      "id": "main_did",
      "label": "Main DiD Results",
      "kind": "table",
      "description": "ATT and SE by outcome, estimator, and specification",
      "scripts": [
        "did_main"
      ],
      "outputs": [
        "assistencia_social/output/data/resultados_did.csv"
      ],
      "source": {
        "document": "paper/paper.pdf",
        "page": null
      },
      "mapping_basis": "MAPA_REPRODUCAO.md"
    },
    {
      "id": "power_mde",
      "label": "Power and MDE Analysis",
      "kind": "table",
      "description": "Minimum detectable effects at 80% power",
      "scripts": [
        "poder_balanco"
      ],
      "outputs": [
        "assistencia_social/output/data/poder_mde.csv"
      ],
      "source": {
        "document": "paper/paper.pdf",
        "page": null
      },
      "mapping_basis": "MAPA_REPRODUCAO.md"
    },
    {
      "id": "pretrends",
      "label": "Pre-Trends Test",
      "kind": "table",
      "description": "Wald p-values for joint significance of leads",
      "scripts": [
        "pretrends_honestdid"
      ],
      "outputs": [
        "assistencia_social/output/data/robustez_pretendencias.csv"
      ],
      "source": {
        "document": "paper/paper.pdf",
        "page": null
      },
      "mapping_basis": "MAPA_REPRODUCAO.md"
    },
    {
      "id": "incentive_heterogeneity",
      "label": "Incentive Heterogeneity",
      "kind": "table",
      "description": "Effect heterogeneity by incentive intensity terciles",
      "scripts": [
        "incentivo_gradient"
      ],
      "outputs": [
        "assistencia_social/output/data/proxy_incentivo_norma.csv",
        "assistencia_social/output/data/proxy_incentivo_norma_gradiente.csv"
      ],
      "source": {
        "document": "paper/paper.pdf",
        "page": null
      },
      "mapping_basis": "MAPA_REPRODUCAO.md"
    }
  ],
